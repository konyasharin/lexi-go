{
  "name": "@repo/entities",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./dist/*/index.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "dev": "concurrently \"tsc -w\" \"tsc-alias -w\"",
    "build": "tsc && tsc-alias"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "tsc-alias": "^1.8.16",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "zod": "^4.0.5"
  }
}
